# Aeroo tidak membutuhkan service-role key di Vercel.
# Koneksi runtime menggunakan Supabase publishable key + session login Aeroo.
# Jangan menaruh SUPABASE_SERVICE_ROLE_KEY atau sb_secret_* di frontend/repository.
# Opsional, hanya di lingkungan server untuk pemetaan target/template dan catatan laporan:
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3-flash
